<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\tooling\msbuild\KsaMod.props" />

	<PropertyGroup>
		<ModName>ShaderExtensions</ModName>

		<VersionPrefix>1.2.0</VersionPrefix>
		<AssemblyVersion>1.2.0.0</AssemblyVersion>

		<Company>AMPW</Company>
		<Authors>AMPW</Authors>
		<Copyright>MIT</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="KittenExtensions">
			<HintPath>$(KSAModsDir)KittenExtensionsContinued/KittenExtensions.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<StarMapModDependency Include="KittenExtensionsContinued">
			<ImportedAssemblies>KittenExtensions</ImportedAssemblies>
		</StarMapModDependency>
	</ItemGroup>

	<Import Project="..\tooling\msbuild\KsaMod.targets" />
</Project>
